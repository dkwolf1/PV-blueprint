# Kies de onderdelen die je gebruikt. Vervang REPLACE_ME door echte entities.
# Forecast kan ook zonder planner draaien.
pv_grid_forecast:
  module: pv_grid_forecast
  class: PVGridForecast
  planner_enabled: false
  price_quarter_entity: sensor.zonneplan_current_quarter_hourly_electricity_tariff
  price_hour_entity: sensor.zonneplan_current_electricity_tariff
  solcast_today_entity: sensor.solcast_pv_forecast_forecast_today
  solcast_tomorrow_entity: sensor.solcast_pv_forecast_forecast_tomorrow
  solcast_power_now_entity: sensor.REPLACE_ME_SOLCAST_POWER_NOW
  ecu_power_entity: sensor.REPLACE_ME_ECU_POWER
  ecu_daily_entity: sensor.REPLACE_ME_ECU_DAILY_ENERGY
  ecu_daily_max_entity: sensor.REPLACE_ME_ECU_DAILY_MAX_POWER
  grid_import_entity: sensor.power_consumption
  grid_export_entity: sensor.power_production
  zonneplan_returned_today_entity: sensor.REPLACE_ME_RETURNED_TODAY
  zonneplan_consumption_today_entity: sensor.REPLACE_ME_CONSUMPTION_TODAY
  threshold_entity: input_number.pv_negatieve_prijs_drempel
  pv_switch_entity: switch.REPLACE_ME_PV_SWITCH
  automatic_entity: input_boolean.pv_automatisch_afschakelen
  manual_block_entity: input_boolean.pv_handmatig_geblokkeerd
  pv_switch_inverted: true  # Pas aan de fysieke relaiswerking aan.
  peak_power_w: 6000  # Vervang door het AC-maximum van jouw PV-installatie.
  storage_file: /homeassistant/python_storage/pv_grid_forecast_data.json

# Zelfstandige planner: verwijder dit blok als planner_enabled hierboven true is.
pv_self_consumption:
  module: pv_self_consumption_app
  class: PVSelfConsumption
  price_quarter_entity: sensor.zonneplan_current_quarter_hourly_electricity_tariff
  solcast_today_entity: sensor.solcast_pv_forecast_forecast_today
  solcast_tomorrow_entity: sensor.solcast_pv_forecast_forecast_tomorrow
  ecu_power_entity: sensor.REPLACE_ME_ECU_POWER
  grid_import_entity: sensor.power_consumption  # kW
  grid_export_entity: sensor.power_production  # kW
  threshold_entity: input_number.pv_negatieve_prijs_drempel
  automatic_entity: input_boolean.pv_automatisch_afschakelen
  manual_block_entity: input_boolean.pv_handmatig_geblokkeerd
  storage_file: /homeassistant/python_storage/pv_self_consumption_data.json
  planning_interval_minutes: 15
  planning_horizon_hours: 24
  planner_devices:
    dishwasher:
      enabled: false  # Zet pas aan na controle van het programma.
      name: Vaatwasser
      mode: fixed_cycle
      priority: 10
      duration_minutes: 150
      estimated_average_power_w: 440
      estimated_peak_power_w: 2100
      earliest_start: "09:00"
      latest_finish: "18:00"

phase_peak_guard:
  module: phase_peak_guard
  class: PhasePeakGuard
  current_l1: sensor.REPLACE_ME_L1_CURRENT
  current_l2: sensor.REPLACE_ME_L2_CURRENT
  current_l3: sensor.REPLACE_ME_L3_CURRENT
  storage_file: /homeassistant/python_storage/phase_peak_guard.json
